# ==============================================================
# ENVIRONMENT VARIABLES — SAMPLE FILE
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit your real `.env` — it's blocked by .gitignore.
# ==============================================================

# ---------- Backend API ----------
# The NTYBL backend (see /server) — leads and all content sections
# (Home, Philosophy, Wellness Areas, Testimonials, FAQ, Footer Links) are
# fetched from here. Leave unset to use the built-in local fallback
# content and a form that reports a submission error.
VITE_API_URL=http://localhost:4000

# ---------- WhatsApp Floating Button ----------
# Full number in international format, digits only.
# Example: 919812345678  (country code 91 + 10-digit mobile)
VITE_WHATSAPP_NUMBER=919999999999
