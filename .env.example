# ==============================================================
# ENVIRONMENT VARIABLES — SAMPLE FILE
# Copy this file to `.env` (or `.env.local`) and fill in real values.
# NEVER commit your real `.env` — it's blocked by .gitignore.
# ==============================================================

# ---------- EmailJS ----------
# Get these from: https://www.emailjs.com/account
VITE_EMAILJS_SERVICE_ID=service_xxxxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here

# ---------- WhatsApp Floating Button ----------
# Full number in international format, digits only.
# Example: 919812345678  (country code 91 + 10-digit mobile)
VITE_WHATSAPP_NUMBER=919999999999
